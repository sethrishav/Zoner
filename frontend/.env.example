# ==============================================================================
# Zoner Frontend Environment Variables
# ==============================================================================

# Backend API URL (Leave unset or '/api' in local dev to use Vite proxy)
# In production on Render: https://zoner-backend.onrender.com/api
VITE_API_URL=https://zoner-backend.onrender.com/api

# MCP Server URL for AI client config snippets
VITE_MCP_SERVER_URL=https://zoner-backend.onrender.com/api/mcp
