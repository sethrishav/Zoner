# ==============================================================================
# Zoner Environment Variables
# Single environment configuration: connects to the deployed PostgreSQL database.
# ==============================================================================

# Deployed PostgreSQL Database (e.g. Neon, Supabase, Render Postgres)
# Example Neon JDBC URL: jdbc:postgresql://ep-example.us-east-2.aws.neon.tech/zoner?sslmode=require
DB_URL=jdbc:postgresql://<HOST>:<PORT>/<DATABASE>?sslmode=require
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_POOL_SIZE=5

# Server Port
PORT=8080

# Frontend URL(s) for CORS (comma-separated if multiple)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-zoner-frontend.vercel.app
